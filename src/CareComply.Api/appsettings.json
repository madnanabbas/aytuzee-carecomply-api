{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mfa": {
      "Issuer": "CareComply",
      "RequiredPermissions": [
        "User.Manage",
        "Role.Manage",
        "Permission.Manage",
        "AuditLog.View"
      ],
      "VerificationRateLimitPermitLimit": 5
    }
  }
}
